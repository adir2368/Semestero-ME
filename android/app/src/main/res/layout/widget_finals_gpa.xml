<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_finals_gpa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SEMESTERO ME • מסלול וממוצע"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_gpa_honors_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🏆 מצטיין דיקן"
            android:textColor="#fbbf24"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Dual Metric Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Countdown to Exam -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_finals_exam_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="106"
                android:textColor="#38bdf8"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_finals_exam_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ימים למועד א׳"
                android:textColor="#cbd5e1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_finals_exam_course"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="מכניקת מוצקים 2"
                android:textColor="#94a3b8"
                android:textSize="9sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:background="#334155" />

        <!-- GPA Metric -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_gpa_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="88.4"
                android:textColor="#10b981"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ממוצע תואר נוכחי"
                android:textColor="#cbd5e1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_gpa_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="יעד סמסטר: 90.0"
                android:textColor="#94a3b8"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Action -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="לפתיחת לוח Study Runway ומחשבון ציונים ↗"
        android:textColor="#38bdf8"
        android:textSize="10sp"
        android:gravity="left" />
</LinearLayout>
