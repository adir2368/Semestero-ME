<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SEMESTERO ME • לוח שבועי"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_schedule_total_hours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="0 ש״ס • טרם הוגדרה מערכת"
            android:textColor="#94a3b8"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5 Days List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <!-- Day 1: Sunday -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="א׳"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_sched_day_sun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="אין שיעורים מתוזמנים"
                android:textColor="#f8fafc"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Day 2: Monday -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="ב׳"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_sched_day_mon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="אין שיעורים מתוזמנים"
                android:textColor="#f8fafc"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Day 3: Tuesday -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="ג׳"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_sched_day_tue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="אין שיעורים מתוזמנים"
                android:textColor="#f8fafc"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Day 4: Wednesday -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">
            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="ד׳"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_sched_day_wed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="אין שיעורים מתוזמנים"
                android:textColor="#f8fafc"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Day 5: Thursday -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="ה׳"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/widget_sched_day_thu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="אין שיעורים מתוזמנים"
                android:textColor="#f8fafc"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Action -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="לצפייה במערכת שעות ומחולל קומבינציות ↗"
        android:textColor="#38bdf8"
        android:textSize="10sp"
        android:gravity="left" />
</LinearLayout>
