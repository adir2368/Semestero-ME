<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="34dp"
    android:paddingEnd="18dp"
    android:paddingBottom="26dp">

    <!-- Interactive Day Switcher Row (Tap ◀ / ▶ to inspect any day of the week, tap center for Today) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_prev_day"
            android:layout_width="24dp"
            android:layout_height="22dp"
            android:background="@drawable/card_timeline_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="◀"
            android:textColor="@color/cyan_accent"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/timeline_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:text="לו״ז יום חמישי"
            android:textColor="@color/cyan_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_next_day"
            android:layout_width="24dp"
            android:layout_height="22dp"
            android:background="@drawable/card_timeline_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/cyan_accent"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable Class List -->
    <ScrollView
        android:id="@+id/timeline_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/timeline_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Populated dynamically via adapter -->

        </LinearLayout>
    </ScrollView>

</LinearLayout>
