<?xml version="1.0" encoding="utf-8"?>
<!--
    Semestero ME • Galaxy Watch 8
    Screen 3: Academic Status & Phone Sync Bridge (סטטוס אקדמי וסנכרון)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_sync"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="34dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_sync_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סמסטרו ME • סמסטר ג׳"
            android:textColor="@color/cyan_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Academic GPA & Honors Card -->
        <LinearLayout
            android:id="@+id/card_academic_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/card_timeline_item"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/tv_sync_gpa_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓 ממוצע: 86.04 • 🎖️ הצטיינות דיקן"
                android:textColor="@color/text_primary"
                android:textSize="9.8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sync_sched_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:text="📅 5 קורסים • 16 ש״ס השבוע"
                android:textColor="@color/text_secondary"
                android:textSize="8.8sp" />
        </LinearLayout>

        <!-- Phone Connection Status Pill -->
        <LinearLayout
            android:id="@+id/layout_sync_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/card_timeline_item"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/tv_phone_status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/tv_phone_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="מחובר לטלפון"
                android:textColor="#f8fafc"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Sync Button -->
        <LinearLayout
            android:id="@+id/btn_trigger_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_refresh_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/tv_sync_btn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 סנכרן נתונים עכשיו"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sync_btn_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="מערכת שעות, משימות וציונים"
                android:textColor="#cbd5e1"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- Test Notification Button -->
        <LinearLayout
            android:id="@+id/btn_test_notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/card_timeline_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_test_notif_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="בדיקת התראת שיעור"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Last Synced Timestamp -->
        <TextView
            android:id="@+id/tv_last_synced_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="סנכרון אחרון: כרגע"
            android:textColor="#64748b"
            android:textSize="9sp" />

    </LinearLayout>
</ScrollView>
