<?xml version="1.0" encoding="utf-8"?>
<!--
    Semestero ME • Galaxy Watch 8
    Screen 3: Phone Sync & Cloud Bridge (סנכרון עם הטלפון)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_sync"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="36dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_sync_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="סנכרון סמסטרו ME"
            android:textColor="@color/cyan_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Subtitle: Semester 3 (Winter 2026/27) -->
        <TextView
            android:id="@+id/tv_sync_semester"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="סמסטר ג׳ • הנדסת מכונות"
            android:textColor="#94a3b8"
            android:textSize="10sp" />

        <!-- Phone Connection Status Pill -->
        <LinearLayout
            android:id="@+id/layout_sync_status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_timeline_item"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <TextView
                android:id="@+id/tv_phone_status_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_phone_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="טלפון מחובר"
                android:textColor="#f8fafc"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Sync Button -->
        <LinearLayout
            android:id="@+id/btn_trigger_sync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_refresh_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/tv_sync_btn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 סנכרן נתונים עכשיו"
                android:textColor="#ffffff"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sync_btn_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="לו״ז, כיתות ומשימות מהטלפון"
                android:textColor="#cbd5e1"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Last Synced Timestamp -->
        <TextView
            android:id="@+id/tv_last_synced_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="סונכרן לאחרונה: הרגע"
            android:textColor="#64748b"
            android:textSize="9.5sp" />

    </LinearLayout>
</ScrollView>
