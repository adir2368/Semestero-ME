<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Semestero ME • Galaxy Watch 8 (44mm & 40mm) Wear OS Layout
    Optimized for circular AMOLED displays (450x450 / 480x480)
    Follows Wear OS 4/5 & One UI 6 Watch design standards
    Features vertically centered widget layout & expandable open tasks inspection
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ScrollView
        android:id="@+id/wear_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="42dp"
            android:paddingEnd="14dp"
            android:paddingBottom="42dp">

            <!-- Watch Header Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/pill_header_badge"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.06"
                    android:text="SEMESTERO ME"
                    android:textColor="@color/cyan_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Today's Day & Live Date Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_current_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="יום ראשון • 1 בנובמבר"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sync_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:text="⚡ מסונכרן עם הטלפון"
                    android:textColor="@color/cyan_accent"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <!-- Card 1: Next Class Radar (Hero Card) -->
            <LinearLayout
                android:id="@+id/card_next_class"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card_rounded_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <!-- Pulsing / Live Status Pill -->
                <TextView
                    android:id="@+id/tv_class_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_status_emerald"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="🟢 מתקיים כעת!"
                    android:textColor="@color/emerald_green"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Course Title -->
                <TextView
                    android:id="@+id/tv_class_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="חדו״א 2מ׳"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Time Interval -->
                <TextView
                    android:id="@+id/tv_class_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="10:30 - 12:30"
                    android:textColor="@color/cyan_accent"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Classroom / Building Location -->
                <TextView
                    android:id="@+id/tv_class_room"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="📍 דנציגר 101"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Card 2: Tasks & Nearest Exam (Expandable on Tap) -->
            <LinearLayout
                android:id="@+id/card_tasks_exam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/card_rounded_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <!-- Nearest Exam Countdown Pill -->
                <TextView
                    android:id="@+id/tv_exam_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_status_amber"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="📝 מבחן מועד א׳ בעוד 14 יום"
                    android:textColor="@color/amber_warning"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <!-- Open Moodle Tasks Summary -->
                <TextView
                    android:id="@+id/tv_tasks_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="2 משימות פתוחות במודל"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- Interactive Tap Hint -->
                <TextView
                    android:id="@+id/tv_tasks_toggle_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="👇 לחץ לצפייה במשימות הפתוחות"
                    android:textColor="@color/cyan_accent"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <!-- Expandable Open Tasks Detail Section -->
                <LinearLayout
                    android:id="@+id/layout_open_tasks_expanded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Separator Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="6dp"
                        android:background="@color/border_subtle" />

                    <!-- Tasks Section Header -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="📋 משימות פתוחות להגשה"
                        android:textColor="@color/cyan_accent"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Tasks List Container -->
                    <LinearLayout
                        android:id="@+id/layout_tasks_items"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Task 1 Card -->
                        <LinearLayout
                            android:id="@+id/task_item_view_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/task_item_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tv_task_1_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="[מדח מ׳] תרגיל בית 3"
                                android:textColor="@color/text_primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_task_1_due"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="⏳ להגשה: יום חמישי (11:30)"
                                android:textColor="@color/amber_warning"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/btn_complete_wear_task_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/pill_task_complete"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="2dp"
                                android:text="✓ סמן כבוצע"
                                android:textColor="@color/emerald_green"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Task 2 Card -->
                        <LinearLayout
                            android:id="@+id/task_item_view_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/task_item_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tv_task_2_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="[פיסיקה 2] דו״ח מעבדה 2"
                                android:textColor="@color/text_primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_task_2_due"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="⏳ להגשה: 8 בנובמבר (23:59)"
                                android:textColor="@color/amber_warning"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/btn_complete_wear_task_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/pill_task_complete"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="2dp"
                                android:text="✓ סמן כבוצע"
                                android:textColor="@color/emerald_green"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Task 3 Card -->
                        <LinearLayout
                            android:id="@+id/task_item_view_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/task_item_bg"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tv_task_3_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="[מוצקים 2] פרויקט תכן מקדים"
                                android:textColor="@color/text_primary"
                                android:textSize="11.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_task_3_due"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="⏳ להגשה: 15 בנובמבר"
                                android:textColor="@color/amber_warning"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/btn_complete_wear_task_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/pill_task_complete"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="2dp"
                                android:text="✓ סמן כבוצע"
                                android:textColor="@color/emerald_green"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Collapse Hint -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="▲ לחץ לצמצום הרשימה"
                        android:textColor="@color/text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Card 3: Academic Standing & Cumulative GPA -->
            <LinearLayout
                android:id="@+id/card_gpa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_rounded_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="🎯 ממוצע תואר"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_gpa_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center"
                    android:letterSpacing="-0.02"
                    android:text="86.04"
                    android:textColor="@color/purple_accent"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_honors_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="🎖️ הצטיינות דיקן"
                    android:textColor="@color/cyan_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_refresh_watch"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/btn_refresh_pill"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="0dp"
                    android:text="🔄 רענן נתונים"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_test_notif"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pill_status_emerald"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingTop="0dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="0dp"
                    android:text="🔔 בדיקת התראה ורטט"
                    android:textColor="@color/emerald_green"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
