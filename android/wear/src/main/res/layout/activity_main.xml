<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Semestero ME • Galaxy Watch 8 Native Layout
    100% Visual Fidelity with watch.html screenshots
    3-Screen Focused Carousel: Radar, Timeline, Tasks & Exams
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_wear_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Ambient Glowing Bezel Ring -->
    <ImageView
        android:id="@+id/iv_bezel_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bezel_glow_ring"
        android:contentDescription="Bezel Glow" />

    <!-- Top Digital Clock & Faculty Badge Header: ME 034 on LEFT, Clock on RIGHT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tv_faculty_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_faculty_badge"
            android:paddingStart="7dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1.5dp"
            android:text="ME 034"
            android:textColor="@color/cyan_accent"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextClock
            android:id="@+id/tc_watch_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#e2e8f0"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main ViewPager2 3-Screen Carousel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/wear_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom Pagination Dots (3 Screens: Radar, Timeline, Tasks) -->
    <LinearLayout
        android:id="@+id/layout_pagination_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="12dp">

        <View
            android:id="@+id/dot_0"
            android:layout_width="14dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/dot_active" />

        <View
            android:id="@+id/dot_1"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/dot_inactive" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/dot_inactive" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:layout_marginHorizontal="2.5dp"
            android:background="@drawable/dot_inactive" />
    </LinearLayout>

</FrameLayout>
