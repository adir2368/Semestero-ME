<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="36dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <!-- Compact Inset Exam Banner Card (Fits cleanly inside top circular glow ring) -->
    <LinearLayout
        android:id="@+id/card_exam_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="7dp"
        android:background="@drawable/card_exam_banner"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="4.5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4.5dp">

        <TextView
            android:id="@+id/tv_exam_banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="בחינה קרובה בעוד 14 ימים"
            android:textColor="@color/amber_warning"
            android:textSize="9.8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_exam_banner_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="104228 - מד״ח מ'"
            android:textColor="@color/text_secondary"
            android:textSize="8.5sp" />
    </LinearLayout>

    <!-- Scrollable Tasks List with Vertical Edge Fade & Bottom Dot Clearance -->
    <ScrollView
        android:id="@+id/tasks_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadingEdgeLength="16dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tasks_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Task Items populated dynamically -->

        </LinearLayout>
    </ScrollView>

</LinearLayout>
