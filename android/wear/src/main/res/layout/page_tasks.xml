<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="36dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <!-- Exam Banner Card -->
    <LinearLayout
        android:id="@+id/card_exam_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/card_exam_banner"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tv_exam_banner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="📝 מועד א׳ בעוד 14 ימים"
            android:textColor="@color/amber_warning"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_exam_banner_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:text="104228 - מד״ח מ'"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Scrollable Tasks List -->
    <ScrollView
        android:id="@+id/tasks_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tasks_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Task Items populated dynamically -->

        </LinearLayout>
    </ScrollView>

</LinearLayout>
