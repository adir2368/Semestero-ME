{
  "name": "semestero-me",
  "productName": "Semestero ME",
  "version": "2.4.19",
  "description": "Semestero ME - Academic Skill Tree and Degree Orchestration System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"Semestero ME\" --platform=win32 --arch=x64 --icon=icon.ico --out=dist --overwrite --ignore=\"^(dist|backups|_backup_widgets|graphify-out)\"",
    "build:mobile": "node scripts/build_mobile_dist.js && npx cap sync android",
    "open:android": "npx cap open android"
  },
  "keywords": [
    "academic",
    "skill-tree",
    "rpg",
    "curriculum",
    "technion",
    "notion-tasks"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-packager": "^17.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  }
}
